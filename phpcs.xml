<?xml version="1.0"?>
<ruleset name="Air-helper">
  <description>Air-helper plugin coding standards using DCS</description>

  <!-- Use DCS standard -->
  <rule ref="DCS"/>

  <!--
    Report cyclomatic complexity as a warning instead of an error. The cache
    flusher and the native lazyload tag builder are long by nature and splitting
    them is tracked separately, so this keeps the signal visible in CI output
    without blocking the build.
  -->
  <rule ref="Generic.Metrics.CyclomaticComplexity.MaxExceeded">
    <type>warning</type>
  </rule>

  <!-- Exclude common folders -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/plugin-update-checker/*</exclude-pattern>
</ruleset>
